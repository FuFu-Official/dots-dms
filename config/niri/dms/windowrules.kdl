// DMS Window Rules - Managed by Dux Shell
// Do not edit manually - changes may be overwritten

// @id=wr_1786867492970805290 @name=firefox
window-rule {
    match app-id="^firefox$"
    open-maximized true
}

// @id=wr_1786867677900341940 @name=Feishu
window-rule {
    match app-id="^Feishu$"
    open-maximized true
}

// @id=wr_1786980695461001130 @name=zen
window-rule {
    match app-id="^zen$"
    open-maximized true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
